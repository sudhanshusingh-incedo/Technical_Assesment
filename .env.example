# Copy to .env and fill in. Never commit .env.

# ---------- LLM ----------
# Choose ONE provider: openai | azure | ollama
LLM__PROVIDER=openai
# LLM__FALLBACK_TO_OLLAMA=true      # retry a failed OpenAI/Azure call on Ollama

# --- OpenAI (api.openai.com, key starts with sk-) ---
OPENAI_API_KEY=
# LLM__ROUTER_MODEL=gpt-4.1-mini    # cheap tier: routing, planning, reflection
# LLM__SYNTH_MODEL=gpt-4.1          # strong tier: final grounded answer
# OPENAI_BASE_URL=                  # only for OpenAI-compatible gateways (vLLM, LM Studio, proxies)

# --- Azure OpenAI (set LLM__PROVIDER=azure). OpenAI keys do not work here, and vice versa. ---
# Endpoint and key: Azure portal > your Azure OpenAI resource > Keys and Endpoint.
# Deployment names: Azure AI Foundry > Deployments (the name you gave, not the model name).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
LLM__AZURE_ROUTER_DEPLOYMENT=       # a small model deployment, e.g. gpt-4.1-mini / gpt-4o-mini
LLM__AZURE_SYNTH_DEPLOYMENT=        # a strong model deployment, e.g. gpt-4.1 / gpt-4o
# LLM__AZURE_API_VERSION=2024-10-21

# --- Ollama (local; docker compose --profile ollama up --build) ---
# LLM__OLLAMA_ROUTER_MODEL=qwen2.5:7b-instruct
# LLM__OLLAMA_SYNTH_MODEL=qwen2.5:7b-instruct

# ---------- API security ----------
# If set, /v1/* requires header "X-API-Key: <value>" (the UI sends it automatically).
API_KEY=

# ---------- Retrieval tuning (defaults in configs/default.yaml) ----------
# RETRIEVAL__TOP_K=6
# RETRIEVAL__MIN_RELEVANCE=0.10
# RETRIEVAL__CANDIDATE_K=20

# ---------- Observability ----------
LOG_LEVEL=INFO
LOG_JSON=true
# Log raw question text (off by default: questions can contain personal data)
LOG_QUESTIONS=false
